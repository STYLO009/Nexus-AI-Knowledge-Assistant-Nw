# LangChain Hugging Face embedding configuration
LANGCHAIN_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LANGCHAIN_EMBEDDING_DEVICE=cpu
LANGCHAIN_EMBEDDING_NORMALIZE=true
LANGCHAIN_EMBEDDING_BATCH_SIZE=32
LANGCHAIN_EMBEDDING_CACHE=/models/huggingface
LANGCHAIN_EMBEDDING_SHOW_PROGRESS=false
# LangChain Hugging Face answer-generation configuration
LANGCHAIN_HF_GENERATION_MODEL=google/gemma-4-31B-it
LANGCHAIN_HF_GENERATION_DEVICE=-1
LANGCHAIN_HF_MAX_NEW_TOKENS=256
HF_TOKEN=
# Optional LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=nexus-rag
LANGCHAIN_API_KEY=
# For Vite dev mode, point the browser at the FastAPI service
VITE_API_URL=http://localhost:8080
# Google Cloud OAuth 2.0 Web client ID (same value is used by the API verifier)
# Generation mode
GENERATION_MODE="huggingface-local-with-extractive-fallback"

